{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"ConnectionStrings": {
		"DefaultConnection": "Host=localhost;Port=5432;Database=gatekeeperhq;Username=postgres;Password=postgres"
	},
	"Jwt": {
		"SecretKey": "",
